PORT=3001
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<from Aura console, shown once at instance creation>
GROQ_API_KEY=<your Groq API key, from console.groq.com/keys>
WEBHOOK_SECRET=<any random string, e.g. generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))">
